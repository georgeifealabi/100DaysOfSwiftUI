// Equatable is what Swift uses to compare property values (i.e. from - let, var) using == and not !=.
// There is another Swift protocol called 'Comparable' which allows Swift to see if one object should be sorted before another.
// We can also delete 'Equatable' from the code as Swift uses something called 'Protocol Inheritance', which means that because the 'Comparable' protocol is being used, it automatically inherites the Equatable protocol behaviour.
struct User: Equatable, Comparable {
    let name: String
    
    static func <(lhs: User, rhs: User) -> Bool {       // lhs means 'left hand side'. rhs means 'right hand side'.
        lhs.name < rhs.name
    }
}

let user1 = User(name: "Link")
let user2 = User(name: "Zelda")
print(user1 == user2)
print(user1 != user2)
print(user1 < user2)
print(user1 <= user2)
print(user1 > user2)
print(user1 >= user2)
