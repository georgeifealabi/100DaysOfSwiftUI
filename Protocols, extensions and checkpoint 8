protocol BuildingDetails2 {
    var buildingType: String { get }
    var rooms: Int { get }
    var cost: Int { get }
    var estateAgent: String { get set }
    func salesSummary()
}

extension BuildingDetails2 {
    func salesSummary() {
        let formatter = NumberFormatter()
        formatter.numberStyle = .decimal
        let formattedCost = formatter.string(from: NSNumber(value: cost)) ?? "\(cost)"
        
        print("This \(buildingType) has \(rooms) room\(rooms == 1 ? "" : "s"). It costs $\(formattedCost) and is being sold by \(estateAgent).")
    }
}

struct House2: BuildingDetails2 {
    let buildingType = "house"
    let rooms: Int
    let cost: Int
    var estateAgent: String
}

struct Office2: BuildingDetails2 {
    let buildingType = "office"
    let rooms: Int
    let cost: Int
    var estateAgent: String
}

let aspectTower2 = Office2(rooms: 178, cost: 28_000_000, estateAgent: "Mr Mahud Saleem")
aspectTower.salesSummary()
// Output: This office has 178 rooms. It costs $28,000,000 and is being sold by Mr Mahud Saleem.

var shawGrove2 = House2(rooms: 3, cost: 90_000, estateAgent: "Sharon Carpenter")
shawGrove.salesSummary()
// Output: This house has 3 rooms. It costs $90,000 and is being sold by Sharon Carpenter.

// Now we can change the agent:
shawGrove2.estateAgent = "John Smith"
shawGrove2.salesSummary()



