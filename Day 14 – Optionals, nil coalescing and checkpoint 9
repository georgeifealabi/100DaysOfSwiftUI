let new2 = captains["Serenity2", default: "N/A"]

// Examples of how it could be used in arrays and a struct below:
let tvShows = ["Archer", "Babylon 5", "Ted Lasso"]
let favourite = tvShows.randomElement() ?? "None"

struct Book {
    let title: String
    let author: String?
}

